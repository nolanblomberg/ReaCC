desc:CC Fader Bridge (for web interface)
// Four automatable values for the web fader bridge.
// The companion ReaScript synchronizes these parameters with the web page.

slider1:0<0,127,1>CC 1
slider2:0<0,127,1>CC 2
slider3:0<0,127,1>CC 3
slider4:0<0,127,1>CC 4

@slider
v1 = floor(slider1 + 0.5);
v2 = floor(slider2 + 0.5);
v3 = floor(slider3 + 0.5);
v4 = floor(slider4 + 0.5);

